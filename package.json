{
  "name": "patra-bus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-static": "node scripts/fetch-static.mjs",
    "build-routes": "node scripts/build-routes.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "dev:worker": "wrangler dev --local --config worker/wrangler.toml --port 8787",
    "dev:web": "http-server web -p 8080 -c-1"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "wrangler": "^4.149.0"
  }
}
